# =====================================================================
# LangChain Agent v1 환경 변수 예시
# 사용법: 이 파일을 `.env`로 복사한 뒤, 사용할 값만 채우면 됩니다.
# =====================================================================

# Google Gemini
# 발급: https://aistudio.google.com/apikey
GOOGLE_API_KEY=

# Groq
# 발급: https://console.groq.com/keys
GROQ_API_KEY=

# Ollama
# 설치: https://ollama.com
# 별도 API 키 없이 로컬 11434 포트를 사용합니다.

# OpenAI
# 발급: https://platform.openai.com/api-keys
OPENAI_API_KEY=

# 04 Tools 노트북의 Tavily 웹 검색
# 발급: https://app.tavily.com
TAVILY_API_KEY=

# 선택적 LangSmith 추적
# 발급: https://smith.langchain.com
# LANGSMITH_API_KEY=
# LANGSMITH_TRACING=true
# LANGSMITH_PROJECT=langchain-agent-v1

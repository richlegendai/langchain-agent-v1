{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "default",
  "description": "ReviewFlow 기본 창의 최소 권한",
  "windows": ["main"],
  "permissions": [
    "core:default",
    "dialog:default",
    {
      "identifier": "shell:allow-execute",
      "allow": [
        {
          "name": "binaries/review-analysis-sidecar",
          "sidecar": true
        }
      ]
    }
  ]
}

{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "ReviewFlow Desktop",
  "version": "0.1.0",
  "identifier": "com.reviewflow.desktop",
  "build": {
    "beforeDevCommand": "pnpm dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "pnpm build",
    "frontendDist": "../dist"
  },
  "app": {
    "security": {
      "csp": "default-src 'self'; connect-src ipc: http://ipc.localhost; img-src 'self' asset: data:; style-src 'self' 'unsafe-inline'; font-src 'self' data:"
    },
    "windows": [
      {
        "title": "ReviewFlow Desktop",
        "width": 1400,
        "height": 900,
        "minWidth": 900,
        "minHeight": 650,
        "center": true
      }
    ]
  },
  "bundle": {
    "active": true,
    "targets": ["dmg", "app"],
    "icon": ["icons/icon.icns", "icons/icon.ico", "icons/icon.png"],
    "macOS": {
      "entitlements": "Entitlements.plist",
      "signingIdentity": "-"
    },
    "externalBin": ["binaries/review-analysis-sidecar"]
  }
}
